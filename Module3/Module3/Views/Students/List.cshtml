@{
}
@model List<StudentModel>
@{
    ViewData["Title"] = "All students";
}
<h2>All students (@Model.Count)</h2>
<ul>
    @foreach (var item in Model)
    {
        <li>@item.Name</li>
    }
</ul>
@foreach (var student in Model)
{
    <partial name="_StudentCard" model="student" />
}