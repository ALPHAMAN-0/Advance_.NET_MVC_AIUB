@model List<ClassTask.Models.StudentModel>

@{
    ViewData["Title"] = "Students";
}

<h2>Student List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Student</a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
       
            <th>Student Name</th>
            <th>Student Email</th>
            <th>Course Code</th>
            <th>Credit Hour</th>
            <th>Semester Fee</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center">No students found.</td>
            </tr>
        }
        @foreach (var student in Model)
        {
            <tr>
             
                <td>@student.name</td>
                <td>@student.email</td>
                <td>@student.courseCode</td>
                <td>@student.hour</td>
                <td>@student.semesterfee</td>
            </tr>
        }
    </tbody>
</table>
