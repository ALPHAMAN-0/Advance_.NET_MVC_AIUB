@{
}
@model List<DepartmentAverageViewModel>
@{
    ViewData["Title"] = "Average Salary by Department";
}

<h2>@ViewData["Title"]</h2>

@if (!Model.Any())
{
    <div class="alert alert-warning">No records found</div>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Department</th>
                <th>Average Salary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.Department</td>
                    <td>@d.AverageSalary.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}